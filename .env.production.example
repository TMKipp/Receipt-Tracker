# Shared
APP_ENV=production
APP_SECRET_KEY=replace-with-32-plus-char-secret
APP_AUTO_CREATE_SCHEMA=false
BACKEND_CORS_ORIGINS=https://app.yourdomain.com

# Backend
POSTGRES_DSN=postgresql+psycopg://user:password@your-postgres-host:5432/receipt_tracker
REDIS_URL=redis://your-redis-host:6379/0
LOCAL_UPLOADS_DIR=dev_uploads
DEV_AUTH_ENABLED=false
DEV_AUTH_EMAIL=demo@example.com
DEV_AUTH_NAME=Demo User
STORAGE_PROVIDER=s3
S3_BUCKET=receipt-tracker-prod
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=replace
S3_SECRET_ACCESS_KEY=replace
S3_PRESIGN_EXPIRY_SECONDS=900

# OCR + AI
AWS_REGION=us-east-1
TEXTRACT_ENABLED=true
OPENAI_ENABLED=true
OPENAI_API_KEY=replace
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_RECEIPT_MODEL=gpt-4o-mini

# QuickBooks Online
QBO_CLIENT_ID=replace
QBO_CLIENT_SECRET=replace
QBO_REDIRECT_URI=https://api.yourdomain.com/api/v1/integrations/quickbooks/callback
QBO_BASE_URL=https://quickbooks.api.intuit.com
QBO_MINOR_VERSION=75

# Microsoft Graph / Excel
MS_CLIENT_ID=replace
MS_CLIENT_SECRET=replace
MS_REDIRECT_URI=https://api.yourdomain.com/api/v1/integrations/microsoft/callback
MS_TENANT_ID=common
MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# RevenueCat
REVENUECAT_WEBHOOK_AUTHORIZATION=replace
REVENUECAT_ENTITLEMENT_KEY=pro
DEFAULT_TRIAL_DAYS=14

# Auto-approval policy
AUTO_APPROVE_MIN_VENDOR_HISTORY=3
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.95

# Sync execution
SYNC_RUN_INLINE=false
MAX_SYNC_ATTEMPTS=3
WORKER_POLL_SECONDS=5
WORKER_PROCESSING_BATCH_SIZE=25
WORKER_SYNC_BATCH_SIZE=25
