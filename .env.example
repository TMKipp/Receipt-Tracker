# Shared
APP_ENV=development
APP_SECRET_KEY=replace-me
APP_AUTO_CREATE_SCHEMA=true
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Backend
POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/receipt_tracker
REDIS_URL=redis://localhost:6379/0
LOCAL_UPLOADS_DIR=dev_uploads
DEV_AUTH_ENABLED=true
DEV_AUTH_EMAIL=demo@example.com
DEV_AUTH_NAME=Demo User
STORAGE_PROVIDER=local
S3_BUCKET=receipt-tracker-dev
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_EXPIRY_SECONDS=900

# OCR + AI
AWS_REGION=us-east-1
TEXTRACT_ENABLED=false
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_RECEIPT_MODEL=gpt-4o-mini

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/api/v1/integrations/quickbooks/callback
QBO_BASE_URL=https://sandbox-quickbooks.api.intuit.com
QBO_MINOR_VERSION=75

# Microsoft Graph / Excel
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/api/v1/integrations/microsoft/callback
MS_TENANT_ID=common
MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Supabase Auth
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=

# RevenueCat
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_ENTITLEMENT_KEY=pro
DEFAULT_TRIAL_DAYS=14

# Auto-approval policy
AUTO_APPROVE_MIN_VENDOR_HISTORY=3
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.95

# Sync execution
SYNC_RUN_INLINE=true
MAX_SYNC_ATTEMPTS=3
WORKER_POLL_SECONDS=5
WORKER_PROCESSING_BATCH_SIZE=25
WORKER_SYNC_BATCH_SIZE=25
